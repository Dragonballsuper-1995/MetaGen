# Use Python 3.12 slim for a smaller footprint
FROM python:3.12-slim

# Install system dependencies for llama-cpp-python and other libs
RUN apt-get update && apt-get install -y \
    build-essential \
    python3-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set up user for Hugging Face Spaces (UID 1000)
RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH

WORKDIR $HOME/app

# Copy requirements and install
COPY --chown=user requirements.txt .
RUN pip install --no-cache-dir --upgrade -r requirements.txt

# Copy the rest of the backend code
COPY --chown=user . .

# Create model directory and ensure it exists
RUN mkdir -p backend/model

# Expose the port HF Spaces uses (7860)
EXPOSE 7860

# Start the FastAPI server
# We use 0.0.0.0 to allow external access within the Space
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "7860"]
